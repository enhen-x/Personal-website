[["Map",1,2,9,10,49,50,399,400,515,516,536,537,557,558],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.18.1","content-config-digest","ec824349796e6886","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[],\"actionBodySizeLimit\":1048576},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false}}","abroad",["Map",11,12,30,31],"redai-yulin-li-de-cunzhuang",{"id":11,"data":13,"body":17,"filePath":18,"digest":19,"rendered":20,"legacyId":29},{"title":14,"date":15,"description":16},"公路沿线的村庄",["Date","2024-09-07T00:00:00.000Z"],"项目沿线散落着一些小村庄。几次路过，几次走进去，留下一些关于当地人生活方式的观察。","项目位于热带雨林深处，距离巴塔市区两小时车程。公路沿线，每隔一段就有一个村庄。\n\n村子里的房子基本是就地取材，砍树造屋，门外留出一块闲坐的区域。路过的时候，经常看见村民三三两两坐在门口，也不知道在聊什么。这里是西班牙殖民地，天主教的痕迹留了下来，礼拜日城里的教徒会聚集做礼拜，公路沿线能看到一些坟墓，睡的是棺材，上面立着十字架。\n\n\n![村庄](/photos/见闻/热带雨林里的村庄/2657180081.rNI0ylSmD8G76QGR91jQ-g.jpeg)\n\n![教堂](/photos/见闻/热带雨林里的村庄/2657180081.PIPEh7sKKqGACtDvOlVFmQ.jpeg)\n\n\n\n\n这里的主要生产方式是采集。香蕉、菠萝蜜，不需要种，直接从林子里取。为了扩大活动范围，当地人还造了木船，沿河采集。畜牧也有，路过一个村子，村民养着十多只羊，放养的，很喜欢趴在刚铺好的沥青路上晒太阳。跑现场的路上，也会遇到扛着猎枪的猎人，打到猎物后挂在路边出售。\n\n\n![木船与河流](/photos/见闻/热带雨林里的村庄/2657180081.jrHufkcRiPP7hvf2D-8Omg.jpeg)\n\n![村庄周边](/photos/见闻/热带雨林里的村庄/2657180081.VCN2BeBjVn-lYR592BO0Hg.jpeg)\n\n\n\n这里没有四季轮换，食物一直充足，种田这种费力的生产方式自然不会被青睐。或许这也是为什么农耕文明大多发展在纬度23度左右的地区——四季轮换逼出了储粮的需求，储粮的需求逼出了农业。\n\n\n\n刚来那几天跑现场，遇到一个十多岁的小孩跑过来问有没有 trabajo（工作）。相比于采集这种自给自足的方式，用劳动力换取工资来购买生活资料，似乎是更有吸引力的选择——就像我们国家二三十年前一样。\n\n公司给当地工人盖的宿舍，用铁皮替换了木材，打了几口井供水。宿舍屋顶上，每间都装着小型信号接收器——手机是这里最受欢迎的东西，办公室周围每天都有人来蹭WiFi。\n\n\n![当地工人宿舍区](/photos/见闻/热带雨林里的村庄/2657180081.ybEf9a96Yu4D6nJuqbYugw.jpeg)\n\n\n项目上有个本地翻译，在广西大学留过学，回来操着一口广西话跟大家交流。大多数工人靠一门技术生存——会开挖机，会操作铺路机，在当地算收入不错的。也有个工人，他兄弟是当地教师，按师傅的说法，算是知识分子家庭，个人素质明显不一样。\n\n\n\n有一次，跟测量组的师傅在附近村子里吃盒饭，饭后在村里转了转。\n\n走进一户人家的门口，只是站在外面看了一眼——木头搭的小屋，里面只有几件生活用品和一块木板床，白天的房间很暗。之前有个摄影师因为拍摄了非洲快饿死的小孩和秃鹫的照片受到了无数谴责，现在站在这里，才觉得注视本身也像是一把刀。\n\n\n![村庄内部](/photos/见闻/热带雨林里的村庄/2657180081.U0D71-UUQ1hDced2eWfsPw.jpeg)\n\n\n\n从小屋出来，在村里的路上走，遇到一个穿西装的小老头过来搭话，应该是村长。他说，脚下这条路是我们项目给平整出来的，还说中国人跟赤几人都是 amigos。\n\n项目有一项福利工程，给沿线村庄平整了足球场，当地人过节会在球场里组织比赛。这个考核指标，在这里有了一点具体的重量。\n\n\n![猎人](/photos/见闻/热带雨林里的村庄/2657180081.3EXoKMTD6u8mKq_o4-mymg.jpeg)","src/content/abroad/redai-yulin-li-de-cunzhuang.md","5f4fac1952895b67",{"html":21,"metadata":22},"\u003Cp>项目位于热带雨林深处，距离巴塔市区两小时车程。公路沿线，每隔一段就有一个村庄。\u003C/p>\n\u003Cp>村子里的房子基本是就地取材，砍树造屋，门外留出一块闲坐的区域。路过的时候，经常看见村民三三两两坐在门口，也不知道在聊什么。这里是西班牙殖民地，天主教的痕迹留了下来，礼拜日城里的教徒会聚集做礼拜，公路沿线能看到一些坟墓，睡的是棺材，上面立着十字架。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%83%AD%E5%B8%A6%E9%9B%A8%E6%9E%97%E9%87%8C%E7%9A%84%E6%9D%91%E5%BA%84/2657180081.rNI0ylSmD8G76QGR91jQ-g.jpeg\" alt=\"村庄\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%83%AD%E5%B8%A6%E9%9B%A8%E6%9E%97%E9%87%8C%E7%9A%84%E6%9D%91%E5%BA%84/2657180081.PIPEh7sKKqGACtDvOlVFmQ.jpeg\" alt=\"教堂\">\u003C/p>\n\u003Cp>这里的主要生产方式是采集。香蕉、菠萝蜜，不需要种，直接从林子里取。为了扩大活动范围，当地人还造了木船，沿河采集。畜牧也有，路过一个村子，村民养着十多只羊，放养的，很喜欢趴在刚铺好的沥青路上晒太阳。跑现场的路上，也会遇到扛着猎枪的猎人，打到猎物后挂在路边出售。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%83%AD%E5%B8%A6%E9%9B%A8%E6%9E%97%E9%87%8C%E7%9A%84%E6%9D%91%E5%BA%84/2657180081.jrHufkcRiPP7hvf2D-8Omg.jpeg\" alt=\"木船与河流\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%83%AD%E5%B8%A6%E9%9B%A8%E6%9E%97%E9%87%8C%E7%9A%84%E6%9D%91%E5%BA%84/2657180081.VCN2BeBjVn-lYR592BO0Hg.jpeg\" alt=\"村庄周边\">\u003C/p>\n\u003Cp>这里没有四季轮换，食物一直充足，种田这种费力的生产方式自然不会被青睐。或许这也是为什么农耕文明大多发展在纬度23度左右的地区——四季轮换逼出了储粮的需求，储粮的需求逼出了农业。\u003C/p>\n\u003Cp>刚来那几天跑现场，遇到一个十多岁的小孩跑过来问有没有 trabajo（工作）。相比于采集这种自给自足的方式，用劳动力换取工资来购买生活资料，似乎是更有吸引力的选择——就像我们国家二三十年前一样。\u003C/p>\n\u003Cp>公司给当地工人盖的宿舍，用铁皮替换了木材，打了几口井供水。宿舍屋顶上，每间都装着小型信号接收器——手机是这里最受欢迎的东西，办公室周围每天都有人来蹭WiFi。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%83%AD%E5%B8%A6%E9%9B%A8%E6%9E%97%E9%87%8C%E7%9A%84%E6%9D%91%E5%BA%84/2657180081.ybEf9a96Yu4D6nJuqbYugw.jpeg\" alt=\"当地工人宿舍区\">\u003C/p>\n\u003Cp>项目上有个本地翻译，在广西大学留过学，回来操着一口广西话跟大家交流。大多数工人靠一门技术生存——会开挖机，会操作铺路机，在当地算收入不错的。也有个工人，他兄弟是当地教师，按师傅的说法，算是知识分子家庭，个人素质明显不一样。\u003C/p>\n\u003Cp>有一次，跟测量组的师傅在附近村子里吃盒饭，饭后在村里转了转。\u003C/p>\n\u003Cp>走进一户人家的门口，只是站在外面看了一眼——木头搭的小屋，里面只有几件生活用品和一块木板床，白天的房间很暗。之前有个摄影师因为拍摄了非洲快饿死的小孩和秃鹫的照片受到了无数谴责，现在站在这里，才觉得注视本身也像是一把刀。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%83%AD%E5%B8%A6%E9%9B%A8%E6%9E%97%E9%87%8C%E7%9A%84%E6%9D%91%E5%BA%84/2657180081.U0D71-UUQ1hDced2eWfsPw.jpeg\" alt=\"村庄内部\">\u003C/p>\n\u003Cp>从小屋出来，在村里的路上走，遇到一个穿西装的小老头过来搭话，应该是村长。他说，脚下这条路是我们项目给平整出来的，还说中国人跟赤几人都是 amigos。\u003C/p>\n\u003Cp>项目有一项福利工程，给沿线村庄平整了足球场，当地人过节会在球场里组织比赛。这个考核指标，在这里有了一点具体的重量。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%83%AD%E5%B8%A6%E9%9B%A8%E6%9E%97%E9%87%8C%E7%9A%84%E6%9D%91%E5%BA%84/2657180081.3EXoKMTD6u8mKq_o4-mymg.jpeg\" alt=\"猎人\">\u003C/p>",{"headings":23,"localImagePaths":24,"remoteImagePaths":25,"frontmatter":26,"imagePaths":28},[],[],[],{"title":14,"date":27,"description":16},["Date","2024-09-07T00:00:00.000Z"],[],"redai-yulin-li-de-cunzhuang.md","yi-ri-zhi-nei-qi-jiang-si-ci",{"id":30,"data":32,"body":36,"filePath":37,"digest":38,"rendered":39,"legacyId":48},{"title":33,"date":34,"description":35},"一日之内起降四次",["Date","2024-08-27T00:00:00.000Z"],"从成都出发，经埃塞俄比亚转机，落地赤道几内亚——22小时，四次起降，以及落地后头几天的印象。","2024年8月27日，凌晨两点，天府机场。\n\n登上埃塞航空的航班，目的地是赤道几内亚首都马拉博，中途在亚的斯亚贝巴转机，再搭国内航班到巴塔。这一趟算下来，22小时飞行，四次起降。\n\n飞机餐是土豆泥配炒饭，土豆泥有点发酸。转机时在亚的斯亚贝巴机场候机，充电口旁边挤满了人，有人横躺三把椅子睡觉，有人铺开毯子就地祷告。同行的旅客里中国人不少，多是来做生意的，也有带着孩子过来的，还遇到一个年轻人说是来旅行——赤几不是旅游目的地，这种选择需要点勇气。\n\n\n![赤几机场](/photos/见闻/第一天一日之内起降四次/2657180081.FL5WUYFlU5oi1fLG3-yplw.jpeg)\n\n![赤几机场](/photos/见闻/第一天一日之内起降四次/2657180081.GKOmkxGlbmGQqACS6yv1iQ.jpeg)\n\n\n机场建设水平，国内 > 埃塞 > 赤几，大概就是这个排序。\n\n下午五点左右落地巴塔。路桥的人已经在出口等着，取完行李直接上车，司机师傅一路100码往营地飚。路上每隔一段就有一个兵站，两个汽油桶加几根树枝，就是一个检查站。车停下来，士兵笑着走过来，师傅摇下车窗，递了个鸡蛋过去，车就放行了。\n\n\n\n![路上风景](/photos/见闻/第一天一日之内起降四次/2657180081.1NRLF_BYHpKZE8KvAGQyVA.jpeg)\n\n![路上风景](/photos/见闻/第一天一日之内起降四次/2657180081.G4jMxmNJfKakQq0XUms3fg.jpeg)\n\n\n\n到营地时天已经黑了，草草吃了顿饭，被安排进一个房间。\n\n第二天早上五点多，推开门以为下雨了，走出去才发现是湿度太高导致地面潮湿。周围的山包和树林都被一层水汽笼罩着，有点像山水画。\n\n\n\n![营地晨雾](/photos/见闻/第一天一日之内起降四次/2657180081.H0y_Va-QvsSoQijwZ2ue5A.jpeg)\n\n![营地](/photos/见闻/第一天一日之内起降四次/2657180081.cwibCvqmrZM1_f9oZJp24g.jpeg)\n\n![营地](/photos/见闻/第一天一日之内起降四次/2657180081.GyjPDGe1a0jjOlK2BFKiFA.jpeg)\n\n\n\n营地的厨师是两个当地人，但做的是中国早餐，稀饭、包子、炒菜，比想象中好很多。项目上大半是四川人，乡音听着亲切，但年龄基本是父辈那一代，最小的也比我大十岁。\n\n这个项目是赤几政府出资的国防边境公路，全长120多公里。巴西的公司先修了60多公里，政府没钱了，队伍撤走，才让中国路桥接手。营地因为路线太长，分成了两个，相距一百多公里。\n\n头几天跟着师傅跑现场，坐着开了十多年的丰田皮卡，沿着这条路一路看过去。\n\n\n![现场](/photos/见闻/第一天一日之内起降四次/2657180081.FCNxlDef2xHkSkEreaMNRA.jpeg)\n\n![现场](/photos/见闻/第一天一日之内起降四次/2657180081.-aMSIt2-zqoxdFvBuYKtcg.jpeg)\n\n![现场](/photos/见闻/第一天一日之内起降四次/2657180081.NnvqivPJdgoOADTvXLe4Ug.jpeg)\n\n\n\n这边的石方需要用炸药爆破后送进碎石厂，再按粒径筛分，运到拌合站按级配拌和。国内一般有专门的碎石厂做这些，这里条件有限，就建了个简易的器械站点，坏了再换。\n\n几天下来，最大的感受不是环境的陌生，而是这里的时间节奏——每天六点上班，现场的工作重复而缓慢，摊铺机一天推进的距离，用肉眼几乎看不出来。\n\n\n![雾气中的公路](/photos/见闻/第一天一日之内起降四次/2657180081.9l93LecR5dxpxNlEKaD4XQ.jpeg)\n\n![雾气中的公路](/photos/见闻/第一天一日之内起降四次/2657180081.fKJQe-CDp46bB-6zZEQ_RQ.jpeg)\n\n\n\n师傅说这边风景不行，植物覆盖率太高，雾气很厚，完全没有层次感，说他在哥伦比亚看到的比这好看多了。不过我觉得这种被水汽包裹的热带雨林，有它自己的样子。","src/content/abroad/yi-ri-zhi-nei-qi-jiang-si-ci.md","84cb204ef64314c4",{"html":40,"metadata":41},"\u003Cp>2024年8月27日，凌晨两点，天府机场。\u003C/p>\n\u003Cp>登上埃塞航空的航班，目的地是赤道几内亚首都马拉博，中途在亚的斯亚贝巴转机，再搭国内航班到巴塔。这一趟算下来，22小时飞行，四次起降。\u003C/p>\n\u003Cp>飞机餐是土豆泥配炒饭，土豆泥有点发酸。转机时在亚的斯亚贝巴机场候机，充电口旁边挤满了人，有人横躺三把椅子睡觉，有人铺开毯子就地祷告。同行的旅客里中国人不少，多是来做生意的，也有带着孩子过来的，还遇到一个年轻人说是来旅行——赤几不是旅游目的地，这种选择需要点勇气。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.FL5WUYFlU5oi1fLG3-yplw.jpeg\" alt=\"赤几机场\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.GKOmkxGlbmGQqACS6yv1iQ.jpeg\" alt=\"赤几机场\">\u003C/p>\n\u003Cp>机场建设水平，国内 > 埃塞 > 赤几，大概就是这个排序。\u003C/p>\n\u003Cp>下午五点左右落地巴塔。路桥的人已经在出口等着，取完行李直接上车，司机师傅一路100码往营地飚。路上每隔一段就有一个兵站，两个汽油桶加几根树枝，就是一个检查站。车停下来，士兵笑着走过来，师傅摇下车窗，递了个鸡蛋过去，车就放行了。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.1NRLF_BYHpKZE8KvAGQyVA.jpeg\" alt=\"路上风景\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.G4jMxmNJfKakQq0XUms3fg.jpeg\" alt=\"路上风景\">\u003C/p>\n\u003Cp>到营地时天已经黑了，草草吃了顿饭，被安排进一个房间。\u003C/p>\n\u003Cp>第二天早上五点多，推开门以为下雨了，走出去才发现是湿度太高导致地面潮湿。周围的山包和树林都被一层水汽笼罩着，有点像山水画。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.H0y_Va-QvsSoQijwZ2ue5A.jpeg\" alt=\"营地晨雾\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.cwibCvqmrZM1_f9oZJp24g.jpeg\" alt=\"营地\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.GyjPDGe1a0jjOlK2BFKiFA.jpeg\" alt=\"营地\">\u003C/p>\n\u003Cp>营地的厨师是两个当地人，但做的是中国早餐，稀饭、包子、炒菜，比想象中好很多。项目上大半是四川人，乡音听着亲切，但年龄基本是父辈那一代，最小的也比我大十岁。\u003C/p>\n\u003Cp>这个项目是赤几政府出资的国防边境公路，全长120多公里。巴西的公司先修了60多公里，政府没钱了，队伍撤走，才让中国路桥接手。营地因为路线太长，分成了两个，相距一百多公里。\u003C/p>\n\u003Cp>头几天跟着师傅跑现场，坐着开了十多年的丰田皮卡，沿着这条路一路看过去。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.FCNxlDef2xHkSkEreaMNRA.jpeg\" alt=\"现场\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.-aMSIt2-zqoxdFvBuYKtcg.jpeg\" alt=\"现场\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.NnvqivPJdgoOADTvXLe4Ug.jpeg\" alt=\"现场\">\u003C/p>\n\u003Cp>这边的石方需要用炸药爆破后送进碎石厂，再按粒径筛分，运到拌合站按级配拌和。国内一般有专门的碎石厂做这些，这里条件有限，就建了个简易的器械站点，坏了再换。\u003C/p>\n\u003Cp>几天下来，最大的感受不是环境的陌生，而是这里的时间节奏——每天六点上班，现场的工作重复而缓慢，摊铺机一天推进的距离，用肉眼几乎看不出来。\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.9l93LecR5dxpxNlEKaD4XQ.jpeg\" alt=\"雾气中的公路\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/photos/%E8%A7%81%E9%97%BB/%E7%AC%AC%E4%B8%80%E5%A4%A9%E4%B8%80%E6%97%A5%E4%B9%8B%E5%86%85%E8%B5%B7%E9%99%8D%E5%9B%9B%E6%AC%A1/2657180081.fKJQe-CDp46bB-6zZEQ_RQ.jpeg\" alt=\"雾气中的公路\">\u003C/p>\n\u003Cp>师傅说这边风景不行，植物覆盖率太高，雾气很厚，完全没有层次感，说他在哥伦比亚看到的比这好看多了。不过我觉得这种被水汽包裹的热带雨林，有它自己的样子。\u003C/p>",{"headings":42,"localImagePaths":43,"remoteImagePaths":44,"frontmatter":45,"imagePaths":47},[],[],[],{"title":33,"date":46,"description":35},["Date","2024-08-27T00:00:00.000Z"],[],"yi-ri-zhi-nei-qi-jiang-si-ci.md","photography",["Map",51,52],"equatorial-guinea",{"id":51,"data":53,"filePath":277,"digest":278,"rendered":279,"legacyId":398},{"title":54,"date":55,"description":56,"location":57,"cover":58,"photos":59},"赤道几内亚印象",["Date","2026-05-13T00:00:00.000Z"],"热带雨林、石油小国与非洲街头——两年工作生活的影像记录","赤道几内亚","/photos/equtarial Guinea/eq-086.jpeg",[60,62,64,66,68,70,72,74,76,78,80,82,84,86,88,90,92,94,96,98,100,102,104,106,108,110,112,114,116,118,120,122,124,126,128,130,132,134,136,138,140,142,144,146,148,150,152,154,156,158,160,162,164,166,168,170,172,174,176,178,180,182,184,186,188,190,192,194,196,198,200,202,204,206,208,210,212,214,216,218,220,222,224,226,228,230,231,233,235,237,239,241,243,245,247,249,251,253,255,257,259,261,263,265,267,269,271,273,275],{"src":61},"/photos/equtarial Guinea/eq-001.jpeg",{"src":63},"/photos/equtarial Guinea/eq-002.jpeg",{"src":65},"/photos/equtarial Guinea/eq-003.jpeg",{"src":67},"/photos/equtarial Guinea/eq-004.jpeg",{"src":69},"/photos/equtarial Guinea/eq-005.jpeg",{"src":71},"/photos/equtarial Guinea/eq-006.jpeg",{"src":73},"/photos/equtarial Guinea/eq-007.jpeg",{"src":75},"/photos/equtarial Guinea/eq-008.jpeg",{"src":77},"/photos/equtarial Guinea/eq-009.jpeg",{"src":79},"/photos/equtarial Guinea/eq-010.jpeg",{"src":81},"/photos/equtarial Guinea/eq-011.jpeg",{"src":83},"/photos/equtarial Guinea/eq-012.jpeg",{"src":85},"/photos/equtarial Guinea/eq-013.jpeg",{"src":87},"/photos/equtarial Guinea/eq-014.jpeg",{"src":89},"/photos/equtarial Guinea/eq-015.jpeg",{"src":91},"/photos/equtarial Guinea/eq-016.jpeg",{"src":93},"/photos/equtarial Guinea/eq-017.jpeg",{"src":95},"/photos/equtarial Guinea/eq-018.jpeg",{"src":97},"/photos/equtarial Guinea/eq