},{"src":425},{"src":427},{"src":429},{"src":431},{"src":433},{"src":435},[],"no-1.md","no-2",{"id":462,"data":464,"filePath":491,"digest":492,"rendered":493,"legacyId":514},{"date":465,"camera":405,"film":406,"cover":466,"photos":467},["Date","2025-12-01T00:00:00.000Z"],"/photos/film/No.2/film-001.jpeg",[468,469,471,473,475,477,479,481,483,485,487,489],{"src":466},{"src":470},"/photos/film/No.2/film-002.jpeg",{"src":472},"/photos/film/No.2/film-003.jpeg",{"src":474},"/photos/film/No.2/film-004.jpeg",{"src":476},"/photos/film/No.2/film-005.jpeg",{"src":478},"/photos/film/No.2/film-006.jpeg",{"src":480},"/photos/film/No.2/film-007.jpeg",{"src":482},"/photos/film/No.2/film-008.jpeg",{"src":484},"/photos/film/No.2/film-009.jpeg",{"src":486},"/photos/film/No.2/film-010.jpeg",{"src":488},"/photos/film/No.2/film-011.jpeg",{"src":490},"/photos/film/No.2/film-012.jpeg","src/content/film/no-2.md","a159497b18740a05",{"html":280,"metadata":494},{"headings":495,"localImagePaths":496,"remoteImagePaths":497,"frontmatter":498,"imagePaths":513},[],[],[],{"date":499,"camera":405,"film":406,"cover":466,"photos":500},["Date","2025-12-01T00:00:00.000Z"],[501,502,503,504,505,506,507,508,509,510,511,512],{"src":466},{"src":470},{"src":472},{"src":474},{"src":476},{"src":478},{"src":480},{"src":482},{"src":484},{"src":486},{"src":488},{"src":490},[],"no-2.md","books",["Map",517,518],"zhi-shen-shi-nei",{"id":517,"data":519,"body":523,"filePath":524,"digest":525,"rendered":526,"legacyId":535},{"title":520,"date":521,"description":522},"《置身事内》",["Date","2026-01-01T00:00:00.000Z"],"一本读懂中国政府行为逻辑的入门书，从土地财政到地方债，把宏观叙事落到具体机制上。","笔记整理中。","src/content/books/zhi-shen-shi-nei.md","a1daa4e39c58481f",{"html":527,"metadata":528},"\u003Cp>笔记整理中。\u003C/p>",{"headings":529,"localImagePaths":530,"remoteImagePaths":531,"frontmatter":532,"imagePaths":534},[],[],[],{"title":520,"date":533,"description":522},["Date","2026-01-01T00:00:00.000Z"],[],"zhi-shen-shi-nei.md","projects",["Map",538,539],"airport-pavement-void-detection",{"id":538,"data":540,"body":544,"filePath":545,"digest":546,"rendered":547,"legacyId":556},{"title":541,"date":542,"description":543},"机场道面板底脱空监测与评估",["Date","2024-06-20T00:00:00.000Z"],"本科毕业设计。基于有限元仿真与振动响应分析，提出一种利用功率谱密度指标定量评估机场水泥混凝土道面板底脱空程度的方法，并延伸为发表于 Measurement 期刊的预测模型研究。","研究背景\r\n\r\n\u003Cdiv style=\"height:1.5rem;\">\u003C/div>\r\n\r\n机场跑道采用水泥混凝土刚性道面结构，长期承受飞机动荷载与自然环境的共同作用。板底脱空是其中一类隐蔽性较强的结构病害——道面板与基层之间出现空隙后，板块失去均匀支承，荷载集中于局部区域，进而引发断板、错台等严重损伤，对飞机起降安全构成威胁。\r\n\r\n现有主流检测手段以落锤式弯沉仪（FWD）为代表，通过测量道面弯沉盆推算脱空状态，技术成熟但无法实现实时监测，且对脱空尺寸的定量评估精度有限。振动响应法作为新兴方向，具备检测效率高、成本低的潜力，但如何从振动信号中提取能够准确反映脱空程度的定量指标，仍是该领域的核心难题。\r\n\r\n---\r\n\r\n\u003Cdiv style=\"height:3rem;\">\u003C/div>\r\n研究内容\r\n\u003Cdiv style=\"height:1.5rem;\">\u003C/div>\r\n\r\n**有限元建模**\r\n\r\n依据机场道面规范参数，使用 ABAQUS 建立了机场水泥混凝土道面板的三维有限元模型。通过在板底设置不同面积的接触脱离区域模拟脱空状态，施加落锤式弯沉仪冲击荷载，获取各测点的加速度时程响应。\r\n\r\n\u003Cfigure style=\"margin:1.25rem 0; text-align:center;\">\r\n  \u003Cimg src=\"/photos/project/No.1/%E5%9B%BE%E7%89%871.png\" alt=\"有限元应力云图（冲击荷载作用下的板体局部响应）\" style=\"display:block; margin:0 auto;\" />\r\n  \u003Cfigcaption style=\"margin-top:0.5rem; font-size:0.9em; color:#666;\">图1. 冲击荷载作用后的局部应力集中区，用于说明脱空邻域在动力作用下的高敏感响应位置。\u003C/figcaption>\r\n\u003C/figure>\r\n\r\n**振动信号分析**\r\n\r\n对冲击荷载作用下的加速度时域信号进行频域变换与小波变换分析，观察脱空状态下道面板振动特征的变化规律。研究发现，板底脱空导致自由振动阶段高频区域幅度显著降低，这一现象为后续指标提取提供了依据。\r\n\r\n\u003Cfigure style=\"margin:1.25rem 0; text-align:center;\">\r\n  \u003Cimg src=\"/photos/project/No.1/%E5%9B%BE%E7%89%872.png\" alt=\"多测点加速度时程响应（传感器阵列）\" style=\"display:block; margin:0 auto;\" />\r\n  \u003Cfigcaption style=\"margin-top:0.5rem; font-size:0.9em; color:#666;\">图2. 多测点加速度时程曲线，体现冲击后自由振动阶段不同测点的响应差异。\u003C/figcaption>\r\n\u003C/figure>\r\n\r\n\u003Cfigure style=\"margin:1.25rem 0; text-align:center;\">\r\n  \u003Cimg src=\"/photos/project/No.1/%E5%9B%BE%E7%89%873.png\" alt=\"无脱空与不同脱空程度的时域/频域对比\" style=\"display:block; margin:0 auto;\" />\r\n  \u003Cfigcaption style=\"margin-top:0.5rem; font-size:0.9em; color:#666;\">图3. 无脱空、轻度脱空、重度脱空工况的时域与频域对比，可见脱空工况下高频分量衰减更明显。\u003C/figcaption>\r\n\u003C/figure>\r\n\r\n在此基础上，提出基于多测点功率谱密度（PSD）积分值的归一化指标，用于量化脱空引起的局部刚度退化与能量耗散。该指标通过传感器阵列采集，可在有限测点条件下实现对脱空状态的定量表征。\r\n\r\n\u003Cfigure style=\"margin:1.25rem 0; text-align:center;\">\r\n  \u003Cimg src=\"/photos/project/No.1/%E5%9B%BE%E7%89%874.png\" alt=\"时域、频域与PSD曲线综合对比（无脱空/0.8m/1.6m）\" style=\"display:block; margin:0 auto;\" />\r\n  \u003Cfigcaption style=\"margin-top:0.5rem; font-size:0.9em; color:#666;\">图4. PSD维度对比显示，随着脱空尺度增大，功率谱密度整体下降且高频段衰减增强，与归一化PSD积分指标的表征思路一致。\u003C/figcaption>\r\n\u003C/figure>\r\n\r\n**正交试验验证**\r\n\r\n设计正交试验，系统考察面层模量、脱空面积、传力杆刚度、阻尼系数等参数对所提指标的影响显著性，通过方差分析验证了脱空面积与功率指标之间的强相关性，为后续预测模型的建立提供了统计依据。\r\n\r\n---\r\n\r\n\u003Cdiv style=\"height:3rem;\">\u003C/div>\r\n延伸研究\r\n\u003Cdiv style=\"height:1.5rem;\">\u003C/div>\r\n\r\n本科毕设完成后，导师课题组在此工作基础上进行了延伸研究，引入实验室缩尺模型试验对振动响应方法的可行性进行了实验验证，并构建了包含 225 个多工况场景的数据集，采用 Histogram-based Gradient Boosting 算法建立了脱空尺寸预测模型。\r\n\r\n预测模型以归一化 PSD 积分指标及道面结构参数（面层厚度、基层厚度、面层弹性模量、基层弹性模量、地基反应模量）为输入，以脱空面积为输出，最终在测试集上取得 R² = 0.825、MAE = 0.178 m 的预测精度。\r\n\r\n该研究以论文形式投稿至 *Measurement* 期刊（Elsevier），本人作为第三作者参与其中。\r\n\r\n> Qiao Dong, Yirui Cao, Xiang Wang, **Songlin Xie**, Ziliang Ma. *Prediction model for Void Sizes beneath Airport Concrete Pavement Slab based on Vibration Monitoring*. Measurement, 2026. https://doi.org/10.1016/j.measurement.2026.120475\r\n\r\n---\r\n\r\n\u003Cdiv style=\"height:3rem;\">\u003C/div>\r\n主要结论\r\n\u003Cdiv style=\"height:1.5rem;\">\u003C/div>\r\n\r\n- 板底脱空在冲击荷载作用下会导致道面板高频振动能量的显著衰减，这一特征可作为脱空识别的物理依据。\r\n- 基于归一化功率谱密度积分值构建的评价指标，能够有效反映不同脱空面积下的结构刚度退化程度。\r\n- 正交试验表明，脱空面积是影响所提指标的最显著因素，验证了该指标用于脱空定量评估的可靠性。\r\n- 基于机器学习的预测模型具备在多种道面结构参数组合下预测脱空尺寸的能力，为机场道面实时监测提供了可行的技术路径。","src/content/projects/airport-pavement-void-detection.md","cd5af8f80e755550",{"html":548,"metadata":549},"\u003Cp>研究背景\u003C/p>\n\u003Cdiv style=\"height:1.5rem;\">\u003C/div>\n\u003Cp>机场跑道采用水泥混凝土刚性道面结构，长期承受飞机动荷载与自然环境的共同作用。板底脱空是其中一类隐蔽性较强的结构病害——道面板与基层之间出现空隙后，板块失去均匀支承，荷载集中于局部区域，进而引发断板、错台等严重损伤，对飞机起降安全构成威胁。\u003C/p>\n\u003Cp>现有主流检测手段以落锤式弯沉仪（FWD）为代表，通过测量道面弯沉盆推算脱空状态，技术成熟但无法实现实时监测，且对脱空尺寸的定量评估精度有限。振动响应法作为新兴方向，具备检测效率高、成本低的潜力，但如何从振动信号中提取能够准确反映脱空程度的定量指标，仍是该领域的核心难题。\u003C/p>\n\u003Chr>\n\u003Cdiv style=\"height:3rem;\">\u003C/div>\n研究内容\n\u003Cdiv style=\"height:1.5rem;\">\u003C/div>\n\u003Cp>\u003Cstrong>有限元建模\u003C/strong>\u003C/p>\n\u003Cp>依据机场道面规范参数，使用 ABAQUS 建立了机场水泥混凝土道面板的三维有限元模型。通过在板底设置不同面积的接触脱离区域模拟脱空状态，施加落锤式弯沉仪冲击荷载，获取各测点的加速度时程响应。\u003C/p>\n\u003Cfigure style=\"margin:1.25rem 0; text-align:center;\">\n  \u003Cimg src=\"/photos/project/No.1/%E5%9B%BE%E7%89%871.png\" alt=\"有限元应力云图（冲击荷载作用下的板体局部响应）\" style=\"display:block; margin:0 auto;\">\n  \u003Cfigcaption style=\"margin-top:0.5rem; font-size:0.9em; color:#666;\">图1. 冲击荷载作用后的局部应力集中区，用于说明脱空邻域在动力作用下的高敏感响应位置。\u003C/figcaption>\n\u003C/figure>\n\u003Cp>\u003Cstrong>振动信号分析\u003C/strong>\u003C/p>\n\u003Cp>对冲击荷载作用下的加速度时域信号进行频域变换与小波变换分析，观察脱空状态下道面板振动特征的变化规律。研究发现，板底脱空导致自由振动阶段高频区域幅度显著降低，这一现象为后续指标提取提供了依据。\u003C/p>\n\u003Cfigure style=\"margin:1.25rem 0; text-align:center;\">\n  \u003Cimg src=\"/photos/project/No.1/%E5%9B%BE%E7%89%872.png\" alt=\"多测点加速度时程响应（传感器阵列）\" style=\"display:block; margin:0 auto;\">\n  \u003Cfigcaption style=\"margin-top:0.5rem; font-size:0.9em; color:#666;\">图2. 多测点加速度时程曲线，体现冲击后自由振动阶段不同测点的响应差异。\u003C/figcaption>\n\u003C/figure>\n\u003Cfigure style=\"margin:1.25rem 0; text-align:center;\">\n  \u003Cimg src=\"/photos/project/No.1/%E5%9B%BE%E7%89%873.png\" alt=\"无脱空与不同脱空程度的时域/频域对比\" style=\"display:block; margin:0 auto;\">\n  \u003Cfigcaption style=\"margin-top:0.5rem; font-size:0.9em; color:#666;\">图3. 无脱空、轻度脱空、重度脱空工况的时域与频域对比，可见脱空工况下高频分量衰减更明显。\u003C/figcaption>\n\u003C/figure>\n\u003Cp>在此基础上，提出基于多测点功率谱密度（PSD）积分值的归一化指标，用于量化脱空引起的局部刚度退化与能量耗散。该指标通过传感器阵列采集，可在有限测点条件下实现对脱空状态的定量表征。\u003C/p>\n\u003Cfigure style=\"margin:1.25rem 0; text-align:center;\">\n  \u003Cimg src=\"/photos/project/No.1/%E5%9B%BE%E7%89%874.png\" alt=\"时域、频域与PSD曲线综合对比（无脱空/0.8m/1.6m）\" style=\"display:block; margin:0 auto;\">\n  \u003Cfigcaption style=\"margin-top:0.5rem; font-size:0.9em; color:#666;\">图4. PSD维度对比显示，随着脱空尺度增大，功率谱密度整体下降且高频段衰减增强，与归一化PSD积分指标的表征思路一致。\u003C/figcaption>\n\u003C/figure>\n\u003Cp>\u003Cstrong>正交试验验证\u003C/strong>\u003C/p>\n\u003Cp>设计正交试验，系统考察面层模量、脱空面积、传力杆刚度、阻尼系数等参数对所提指标的影响显著性，通过方差分析验证了脱空面积与功率指标之间的强相关性，为后续预测模型的建立提供了统计依据。\u003C/p>\n\u003Chr>\n\u003Cdiv style=\"height:3rem;\">\u003C/div>\n延伸研究\n\u003Cdiv style=\"height:1.5rem;\">\u003C/div>\n\u003Cp>本科毕设完成后，导师课题组在此工作基础上进行了延伸研究，引入实验室缩尺模型试验对振动响应方法的可行性进行了实验验证，并构建了包含 225 个多工况场景的数据集，采用 Histogram-based Gradient Boosting 算法建立了脱空尺寸预测模型。\u003C/p>\n\u003Cp>预测模型以归一化 PSD 积分指标及道面结构参数（面层厚度、基层厚度、面层弹性模量、基层弹性模量、地基反应模量）为输入，以脱空面积为输出，最终在测试集上取得 R² = 0.825、MAE = 0.178 m 的预测精度。\u003C/p>\n\u003Cp>该研究以论文形式投稿至 \u003Cem>Measurement\u003C/em> 期刊（Elsevier），本人作为第三作者参与其中。\u003C/p>\n\u003Cblockquote>\n\u003Cp>Qiao Dong, Yirui Cao, Xiang Wang, \u003Cstrong>Songlin Xie\u003C/strong>, Ziliang Ma. \u003Cem>Prediction model for Void Sizes beneath Airport Concrete Pavement Slab based on Vibration Monitoring\u003C/em>. Measurement, 2026. \u003Ca href=\"https://doi.org/10.1016/j.measurement.2026.120475\">https://doi.org/10.1016/j.measurement.2026.120475\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Cdiv style=\"height:3rem;\">\u003C/div>\n主要结论\n\u003Cdiv style=\"height:1.5rem;\">\u003C/div>\n\u003Cul>\n\u003Cli>板底脱空在冲击荷载作用下会导致道面板高频振动能量的显著衰减，这一特征可作为脱空识别的物理依据。\u003C/li>\n\u003Cli>基于归一化功率谱密度积分值构建的评价指标，能够有效反映不同脱空面积下的结构刚度退化程度。\u003C/li>\n\u003Cli>正交试验表明，脱空面积是影响所提指标的最显著因素，验证了该指标用于脱空定量评估的可靠性。\u003C/li>\n\u003Cli>基于机器学习的预测模型具备在多种道面结构参数组合下预测脱空尺寸的能力，为机场道面实时监测提供了可行的技术路径。\u003C/li>\n\u003C/ul>",{"headings":550,"localImagePaths":551,"remoteImagePaths":552,"frontmatter":553,"imagePaths":555},[],[],[],{"title":541,"date":554,"description":543},["Date","2024-06-20T00:00:00.000Z"],[],"airport-pavement-void-detection.md","economics",["Map",559,560],"eq-oil-economy",{"id":559,"data":561,"body":565,"filePath":566,"digest":567,"rendered":568,"legacyId":577},{"title":562,"date":563,"description":564},"赤道几内亚的石油经济观察",["Date","2024-03-01T00:00:00.000Z"],"一个非洲小国如何依靠石油收入快速发展，又面临哪些结构性困境。","这是一篇示例经济文章。","src/content/economics/eq-oil-economy.md","27628676016a6e69",{"html":569,"metadata":570},"\u003Cp>这是一篇示例经济文章。\u003C/p>",{"headings":571,"localImagePaths":572,"remoteImagePaths":573,"frontmatter":574,"imagePaths":576},[],[],[],{"title":562,"date":575,"description":564},["Date","2024-03-01T00:00:00.000Z"],[],"eq-oil-economy.md"]