---
interface Props {
  title: string;
}
const { title } = Astro.props;
const nav = [
  { href: '/abroad', label: '海外见闻' },
  { href: '/projects', label: '主要项目' },
  { href: '/economics', label: '经济探索' },
  { href: '/books', label: '读书笔记' },
  { href: '/photography', label: '摄影' },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur border-b border-gray-200">
      <nav class="max-w-6xl mx-auto px-8 py-4 flex items-center justify-between">
        <a href="/" class="font-semibold text-gray-900 tracking-wide hover:text-gray-500 transition-colors">
          个人空间
        </a>
        <ul class="flex items-center gap-8 text-sm text-gray-500">
          {nav.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class={`hover:text-gray-900 transition-colors ${currentPath.startsWith(href) ? 'text-gray-900 font-medium' : ''}`}
              >
                {label}
              </a>
            </li>
          ))}
          <li>
            <a
              href="https://github.com/enhen-x"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-gray-900 transition-colors"
              aria-label="GitHub"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>
              </svg>
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main class="pt-[57px]">
      <slot />
    </main>
    <footer class="border-t border-gray-200 mt-0">
      <div class="max-w-6xl mx-auto px-8 py-8 text-sm text-gray-400 text-center">
        © {new Date().getFullYear()}
      </div>
    </footer>
  </body>
</html>
