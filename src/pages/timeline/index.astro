---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('timeline');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="人生轨迹">
  <section class="max-w-2xl mx-auto py-16 px-4">
    <h1 class="text-3xl font-bold mb-12">人生轨迹</h1>
    <div class="relative border-l border-gray-200 pl-8 space-y-10">
      {sorted.map((item) => (
        <div class="relative">
          <span class="absolute -left-10 w-4 h-4 rounded-full bg-gray-800 border-2 border-white"></span>
          <time class="text-sm text-gray-400">{item.data.date.getFullYear()}</time>
          <h2 class="text-xl font-semibold mt-1">{item.data.title}</h2>
          <p class="text-gray-600 mt-1">{item.data.description}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
