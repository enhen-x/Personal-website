---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const albums = await getCollection('photography');
const sorted = albums.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="摄影">
  <section class="max-w-6xl mx-auto py-16 px-8">
    <p class="text-[#4a9eff] text-xs font-semibold tracking-widest uppercase mb-3">PHOTOGRAPHY</p>
    <h1 class="text-white text-4xl font-bold mb-4">摄影</h1>
    <p class="text-gray-400 mb-12">用镜头记录路上的光与影——赤道几内亚、工地现场、异乡街头。</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {sorted.map((album) => (
        <a href={`/photography/${album.slug}`} class="group relative overflow-hidden aspect-[4/3] bg-gray-900 block">
          <img
            src={album.data.cover}
            alt={album.data.title}
            class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5">
            {album.data.location && (
              <span class="text-[#4a9eff] text-xs font-semibold tracking-widest uppercase">
                {album.data.location}
              </span>
            )}
            <h2 class="text-white text-lg font-bold mt-1">{album.data.title}</h2>
            <p class="text-gray-300 text-sm mt-1 line-clamp-2">{album.data.description}</p>
          </div>
        </a>
      ))}
    </div>

    {sorted.length === 0 && (
      <p class="text-gray-600 text-center py-20">图集整理中，敬请期待。</p>
    )}
  </section>
</BaseLayout>
