---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const rolls = await getCollection('film');
const sorted = rolls.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="胶片">
  <section class="max-w-6xl mx-auto py-16 px-8">
    <a href="/photography" class="text-[#4a9eff] text-xs font-semibold tracking-widest uppercase hover:text-white transition-colors">← PHOTOGRAPHY</a>
    <p class="text-gray-300 text-xs tracking-widest uppercase mb-4 mt-6">FILM</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">胶片</h1>
    <p class="text-gray-400 mb-12">每一卷胶片，都是一次不可撤销的选择</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {sorted.map((roll, i) => (
        <a href={`/photography/film/${roll.slug}`} class="group relative overflow-hidden aspect-[4/3] bg-gray-900 block">
          <img
            src={roll.data.cover}
            alt={roll.data.title ?? `No.${sorted.length - i}`}
            class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5">
            {(roll.data.camera || roll.data.film) && (
              <span class="text-[#4a9eff] text-xs font-semibold tracking-widest uppercase">
                {[roll.data.camera, roll.data.film].filter(Boolean).join(' · ')}
              </span>
            )}
            <h2 class="text-white text-lg font-bold mt-1">{roll.data.title ?? `No.${sorted.length - i}`}</h2>
            {roll.data.description && (
              <p class="text-gray-300 text-sm mt-1 line-clamp-2">{roll.data.description}</p>
            )}
          </div>
        </a>
      ))}
    </div>

    {sorted.length === 0 && (
      <p class="text-gray-600 text-center py-20">胶片整理中，敬请期待</p>
    )}
  </section>
</BaseLayout>
