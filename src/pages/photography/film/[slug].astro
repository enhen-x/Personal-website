---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const rolls = await getCollection('film');
  return rolls.map((roll) => ({ params: { slug: roll.slug }, props: { roll } }));
}

const { roll } = Astro.props;
const { data } = roll;
---

<BaseLayout title={data.title ?? 'Film'}>
  <!-- Hero -->
  <div class="relative w-full h-[50vh] min-h-[320px] overflow-hidden">
    <img src={data.cover} alt={data.title ?? ''} class="w-full h-full object-cover opacity-60" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0b0d17] via-[#0b0d17]/40 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 max-w-6xl mx-auto px-8 pb-10">
      <a href="/photography/film" class="text-[#4a9eff] text-xs font-semibold tracking-widest uppercase hover:text-white transition-colors">
        ← FILM
      </a>
      {(data.camera || data.film) && (
        <p class="text-[#4a9eff] text-xs font-semibold tracking-widest uppercase mt-3">
          {[data.camera, data.film].filter(Boolean).join(' · ')}
        </p>
      )}
      {data.title && <h1 class="text-white text-4xl font-bold mt-1">{data.title}</h1>}
      {data.description && <p class="text-gray-300 mt-2 max-w-xl">{data.description}</p>}
      <time class="text-gray-500 text-sm mt-2 block">{data.date.toLocaleDateString('zh-CN')}</time>
    </div>
  </div>

  <!-- Photo grid -->
  <section class="max-w-6xl mx-auto px-8 py-12">
    <div class="columns-1 md:columns-2 lg:columns-3 gap-4 space-y-4">
      {data.photos.map((photo) => (
        <div class="break-inside-avoid group relative overflow-hidden bg-gray-900">
          <img
            src={photo.src}
            alt={photo.caption ?? ''}
            class="w-full object-cover group-hover:opacity-90 transition-opacity duration-300"
            loading="lazy"
          />
          {photo.caption && (
            <p class="text-gray-500 text-xs px-2 py-2">{photo.caption}</p>
          )}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
