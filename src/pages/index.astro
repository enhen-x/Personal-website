---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const albums = await getCollection('photography');
const previewAlbums = albums
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 4);

const collections = await Promise.all([
  getCollection('abroad'),
  getCollection('projects'),
  getCollection('economics'),
  getCollection('books'),
]);
const sectionNames = ['abroad', 'projects', 'economics', 'books'];
const sectionTags = ['见闻', '项目', '经济', '读书'];

const allPosts = collections.flatMap((col, i) => {
  const sorted = col.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  return sorted.map((p, j) => ({
    title: p.data.title,
    date: p.data.date,
    href: `/${sectionNames[i]}/${p.slug}`,
    sectionTag: sectionTags[i],
    no: j + 1,
  }));
});
const recentPosts = allPosts
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);

const sections = [
  {
    href: '/abroad',
    label: '见闻',
    description: '异乡的街道，陌生的语言，一个中国人在世界各处的观察与记录',
    tag: 'ABROAD',
  },
  {
    href: '/projects',
    label: '项目',
    description: '用手和脑做过的事，留下来的痕迹',
    tag: 'PROJECTS',
  },
  {
    href: '/economics',
    label: '经济',
    description: '数字背后的人，市场背后的逻辑，以及更多的疑问',
    tag: 'ECONOMICS',
  },
  {
    href: '/books',
    label: '读书',
    description: '读过的书，留下思考的痕迹',
    tag: 'BOOKS',
  },
  {
    href: '/photography',
    label: '摄影',
    description: '光线落下来的那一刻，值得被记住',
    tag: 'PHOTOGRAPHY',
  },
];
---

<BaseLayout title="首页">
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-8 pt-20 pb-12">
    <h1 class="text-5xl md:text-6xl font-bold text-gray-900 leading-tight mb-4 tracking-tight">
    星空之外
    </h1>
    <p class="text-gray-400 text-base max-w-md leading-relaxed">
      我们不正是为了触及不可知的边界<br />才来到这片星空下的吗
    </p>
  </section>

  <!-- Where / Who -->
  <section class="max-w-6xl mx-auto px-8 py-10 border-b border-gray-100">
    <div class="flex flex-col md:flex-row gap-8 md:gap-12">
      <!-- 头像 -->
      <div class="shrink-0 flex justify-center md:justify-start">
        <img
          src="/photos/profile/ef00a9f15c4043ceea0cf65a5646a7c.jpg"
          alt="profile"
          class="w-24 h-24 md:w-28 md:h-28 rounded-full object-cover mt-6"
        />
      </div>
      <!-- 内容 -->
      <div class="flex flex-col md:flex-row gap-px bg-gray-100 flex-1">
        <div class="bg-white pr-8 py-6 md:pr-12 flex-1">
          <p class="text-gray-300 text-xs tracking-widest uppercase mb-3">WHO AM I</p>
          <ul class="text-gray-700 text-sm leading-loose space-y-1">
            <li class="flex gap-2"><span class="shrink-0">→</span><span>Hi，我是 小林Schelling — 一个在赤道几内亚修路的工程师</span></li>
            <li class="flex gap-2"><span class="shrink-0">→</span><span>探索理工、动漫、摄影、西语、投资、人文、仍在完善ing</span></li>
            <li class="flex gap-2"><span class="shrink-0">→</span><span>下一站是 KTH · Mechanical Engineering</span></li>
          </ul>
        </div>
        <div class="bg-white py-6 md:pl-12 border-t md:border-t-0 md:border-l border-gray-100 flex-1">
          <p class="text-gray-300 text-xs tracking-widest uppercase mb-3">WHERE IS IT</p>
          <ul class="text-gray-700 text-sm leading-loose space-y-1">
            <li class="flex gap-2"><span class="shrink-0">→</span><span>这里是 小林Schelling 的精神自留地</span></li>
            <li class="flex gap-2"><span class="shrink-0">→</span><span>种什么、怎么种，都由我说了算</span></li>
            <li class="flex gap-2"><span class="shrink-0">→</span><span>这里有我的见闻、自己鼓捣的项目、对经济的思考、在读的书和一些照片</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent posts -->
  {recentPosts.length > 0 && (
    <section class="max-w-6xl mx-auto px-8 pb-12 border-b border-gray-100">
      <p class="text-gray-400 text-xs tracking-widest uppercase mb-4">最近更新</p>
      <div class="divide-y divide-gray-100">
        {recentPosts.map((post) => (
          <a href={post.href} class="group flex items-center gap-6 py-3 transition-colors">
            <time class="text-gray-300 text-xs tabular-nums w-24 shrink-0">
              {post.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
            <span class="text-gray-300 text-xs w-16 shrink-0">{post.sectionTag}</span>
            <span class="text-gray-700 text-sm group-hover:text-gray-900 transition-colors flex-1 truncate">
                <span class="text-gray-300 font-mono mr-1.5">No.{post.no}</span>{post.title}
              </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-200 group-hover:text-gray-400 shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Section cards -->
  <section class="max-w-6xl mx-auto px-8 py-12 border-b border-gray-100">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-100">
      {sections.map((s) => (
        <a
          href={s.href}
          class="group bg-white hover:bg-gray-50 p-8 flex flex-col gap-2 transition-colors"
        >
          <span class="text-gray-300 text-xs tracking-widest">{s.tag}</span>
          <h3 class="text-gray-900 text-base font-semibold group-hover:text-gray-500 transition-colors">
            {s.label}
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed">{s.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Photography preview -->
  {previewAlbums.length > 0 && (
    <section class="max-w-6xl mx-auto px-8 py-12">
      <div class="flex items-center justify-between mb-6">
        <p class="text-gray-400 text-xs tracking-widest uppercase">近期摄影</p>
        <a href="/photography" class="text-gray-400 text-xs hover:text-gray-700 transition-colors">
          查看全部 →
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {previewAlbums.map((album) => (
          <a href={`/photography/${album.slug}`} class="group relative overflow-hidden aspect-[4/3] bg-gray-100 block">
            <img
              src={album.data.cover}
              alt={album.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <h3 class="text-white text-sm font-medium">{album.data.title}</h3>
              {album.data.location && (
                <p class="text-white/60 text-xs mt-0.5">{album.data.location}</p>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
