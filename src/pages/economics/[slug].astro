---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('economics');
  const sorted = posts.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  return sorted.map((post, i) => ({ params: { slug: post.slug }, props: { post, no: i + 1 } }));
}

const { post, no } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title}>
  <article class="max-w-2xl mx-auto px-8 pt-16 pb-24">
    <a href="/economics" class="text-gray-400 text-xs hover:text-gray-700 transition-colors">← 经济探索</a>
    <p class="text-gray-300 text-xs tracking-widest uppercase mt-6 mb-3">ECONOMICS · No.{no}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-3">{post.data.title}</h1>
    <time class="text-gray-300 text-xs">
      {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <div class="prose prose-gray mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
