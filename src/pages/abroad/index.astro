---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('abroad');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="海外见闻">
  <section class="max-w-2xl mx-auto py-16 px-4">
    <h1 class="text-3xl font-bold mb-4">海外见闻</h1>
    <p class="text-gray-500 mb-12">异乡的街道，陌生的语言，一个中国人在世界各处的观察与记录</p>
    <div class="space-y-8">
      {sorted.map((post) => (
        <a href={`/abroad/${post.slug}`} class="block group">
          <time class="text-sm text-gray-400">{post.data.date.toLocaleDateString('zh-CN')}</time>
          <h2 class="text-xl font-semibold mt-1 group-hover:underline">{post.data.title}</h2>
          <p class="text-gray-600 mt-1">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
