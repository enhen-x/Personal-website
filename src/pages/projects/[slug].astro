---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('projects');
  const sorted = posts.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  return sorted.map((post, i) => ({ params: { slug: post.slug }, props: { post, no: i + 1 } }));
}

const { post, no } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title}>
  <style is:global>
    .entry-content p,
    .entry-content img,
    .entry-content hr,
    .entry-content figure {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }

    .entry-content p {
      line-height: 1.75 !important;
    }

    .entry-content > * + * {
      margin-top: 2rem !important;
    }

    .entry-content p > img {
      display: block;
      margin-top: 2rem !important;
      margin-bottom: 0 !important;
    }
  </style>

  <article class="max-w-2xl mx-auto px-8 pt-16 pb-24">
    <a href="/projects" class="text-gray-400 text-xs hover:text-gray-700 transition-colors">← 主要项目</a>
    <p class="text-gray-300 text-xs tracking-widest uppercase mt-6 mb-3">PROJECTS · No.{no}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-3">{post.data.title}</h1>
    <div class="flex items-center gap-4">
      <time class="text-gray-300 text-xs">
        {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {post.data.tags && (
        <div class="flex gap-2 flex-wrap">
          {post.data.tags.map((tag: string) => (
            <span class="text-xs text-gray-400 border border-gray-200 px-2 py-0.5">{tag}</span>
          ))}
        </div>
      )}
    </div>
    <div class="entry-content prose prose-gray mt-10 max-w-none prose-h2:mt-12 prose-h2:mb-4 prose-p:leading-relaxed prose-hr:my-10">
      <Content />
    </div>
  </article>
</BaseLayout>
