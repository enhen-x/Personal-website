---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('projects');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title}>
  <article class="max-w-2xl mx-auto py-16 px-4 prose prose-gray">
    <a href="/projects" class="text-sm text-gray-400 hover:text-gray-600 no-underline">← 主要项目</a>
    <h1 class="mt-6">{post.data.title}</h1>
    <time class="text-sm text-gray-400">{post.data.date.toLocaleDateString('zh-CN')}</time>
    {post.data.tags && (
      <div class="flex gap-2 mt-2 flex-wrap not-prose">
        {post.data.tags.map((tag: string) => (
          <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">{tag}</span>
        ))}
      </div>
    )}
    <Content />
  </article>
</BaseLayout>
