---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('projects');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="主要项目">
  <section class="max-w-2xl mx-auto py-16 px-4">
    <h1 class="text-3xl font-bold mb-12">主要项目</h1>
    <div class="space-y-8">
      {sorted.map((post) => (
        <a href={`/projects/${post.slug}`} class="block group border border-gray-100 rounded-lg p-6 hover:border-gray-300 transition-colors">
          <time class="text-sm text-gray-400">{post.data.date.toLocaleDateString('zh-CN')}</time>
          <h2 class="text-xl font-semibold mt-1 group-hover:underline">{post.data.title}</h2>
          <p class="text-gray-600 mt-2">{post.data.description}</p>
          {post.data.tags && (
            <div class="flex gap-2 mt-3 flex-wrap">
              {post.data.tags.map((tag: string) => (
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
