---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const books = await getCollection('books');
  const sorted = books.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  return sorted.map((post, i) => ({ params: { slug: post.slug }, props: { post, no: i + 1 } }));
}

const { post, no } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title}>
  <style is:global>
    .entry-content p,
    .entry-content img,
    .entry-content figure,
    .entry-content h1,
    .entry-content h2,
    .entry-content h3,
    .entry-content h4 {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }

    .entry-content hr {
      margin-top: 3rem !important;
      margin-bottom: 3rem !important;
    }

    .entry-content p {
      line-height: 1.75 !important;
    }

    .entry-content table {
      width: 100% !important;
      table-layout: fixed !important;
      border-collapse: collapse !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }

    .entry-content th,
    .entry-content td {
      padding: 0.55rem 0.75rem !important;
      text-align: left !important;
      vertical-align: top !important;
      border-bottom: 1px solid #e5e7eb !important;
      word-break: break-word !important;
    }

    .entry-content thead th {
      font-weight: 700 !important;
      border-bottom: 1.5px solid #d1d5db !important;
    }

    .entry-content th:first-child,
    .entry-content td:first-child {
      width: 32% !important;
    }

    .entry-content > * + * {
      margin-top: 2rem !important;
    }

    .entry-content :is(h1, h2, h3) {
      margin-top: 1.5rem !important;
    }

    .entry-content :is(h1, h2, h3) + * {
      margin-top: 1.5rem !important;
    }

    .entry-content h4 {
      margin-top: 1.5rem !important;
    }

    .entry-content h4 + * {
      margin-top: 0 !important;
    }

    .entry-content p + ol {
      margin-top: 0 !important;
    }

    .entry-content p:has(> strong:first-child) {
      margin-top: 0 !important;
    }

    .entry-content p > img {
      display: block;
      margin-top: 2rem !important;
      margin-bottom: 0 !important;
    }

    .entry-content p:has(> img) + p {
      margin-top: 3rem !important;
    }
  </style>

  <article class="max-w-2xl mx-auto px-8 pt-16 pb-24">
    <a href="/books" class="text-gray-400 text-xs hover:text-gray-700 transition-colors">← 读书笔记</a>
    <p class="text-gray-300 text-xs tracking-widest uppercase mt-6 mb-3">BOOKS · No.{no}</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-3">{post.data.title}</h1>
    <time class="text-gray-300 text-xs">
      {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <div class="entry-content prose prose-gray mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
