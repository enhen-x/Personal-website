---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const books = await getCollection('books');
const sorted = books.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="读书笔记">
  <section class="max-w-6xl mx-auto px-8 pt-16 pb-8">
    <p class="text-gray-300 text-xs tracking-widest uppercase mb-4">BOOKS</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">读书笔记</h1>
    <p class="text-gray-400 text-sm">读过的书，留下思考的痕迹</p>
  </section>

  <section class="max-w-6xl mx-auto px-8 pb-20">
    {sorted.length > 0 ? (
      <div class="divide-y divide-gray-100">
        {sorted.map((post) => (
          <a href={`/books/${post.slug}`} class="group flex items-start gap-8 py-6 hover:bg-gray-50 -mx-4 px-4 transition-colors">
            <time class="text-gray-300 text-xs tabular-nums w-24 shrink-0 pt-1">
              {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
            <div class="flex-1 min-w-0">
              <h2 class="text-gray-900 text-base font-medium group-hover:text-gray-500 transition-colors">{post.data.title}</h2>
              <p class="text-gray-400 text-sm mt-1 leading-relaxed">{post.data.description}</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-200 group-hover:text-gray-400 shrink-0 mt-1 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-gray-300 text-sm py-12">笔记整理中</p>
    )}
  </section>
</BaseLayout>
